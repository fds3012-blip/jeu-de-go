# Copie ce fichier en .env.local (ignoré par git) pour activer les comptes en local.
# Mêmes variables à définir dans Vercel (Production et Preview), en type « Config » et non « Secret » : les variables VITE_ sont intégrées au code envoyé au navigateur.
# Ces deux valeurs sont PUBLIQUES (URL du projet et clé publishable). Ne mets JAMAIS la clé service ici.
# Sans elles, l'application fonctionne hors connexion.
VITE_SUPABASE_URL=https://xjvsalkvpgcjrznznxoi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oV20-APHu-f6cTy02Djcpw__YfgVyyo

# Connexion sociale (issues #354, #411 ; docs/growth/connexion-sociale.md). Un drapeau par fournisseur : 1 = le bouton
# apparaît (sauf dans Messenger, Instagram, TikTok… et l'app installée sur iPhone) ; absente ou vide = rien n'apparaît.
# Active d'abord le fournisseur dans Supabase (Authentication → Sign In / Providers), PUIS mets 1 dans Vercel.
# Valeurs publiques : aucun identifiant ni secret de Google, Apple ou Meta ici (ils vont seulement dans Supabase).
VITE_AUTH_GOOGLE=
VITE_AUTH_APPLE=
VITE_AUTH_FACEBOOK=

# Réseau KataGo (facultatif). Par défaut : copie du dépôt KataGo sur raw.githubusercontent.com.
# Pour le servir avec l'app : npm run fetch-model, puis :
# VITE_KATAGO_MODEL_URL=/models/g170-b6c96-s175395328-d26788732.bin.gz
# Mesure d'audience et erreurs (issue #12). Valeurs PUBLIQUES (clé projet PostHog phc_..., DSN Sentry).
# Vides : rien n'est chargé ni envoyé (la fenêtre de consentement s'affiche quand même au premier lancement : elle mène aux conditions).
# Ne mets JAMAIS ici une clé personnelle PostHog (phx_...) ni un jeton d'API Sentry.
VITE_POSTHOG_KEY=phc_orbva2mqLXmm86j5kHayZusY2voMxbB7r35BgeZCXcEZ
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_SENTRY_DSN=https://9a09d92f2e91ea6042535c3d8d3ed79c@o4512155357544448.ingest.de.sentry.io/4512157171843152
# Version de déploiement : sur Vercel, VITE_VERCEL_GIT_COMMIT_SHA est fourni automatiquement. Repli : 'dev'.
VITE_APP_VERSION=
# Rappel quotidien (issue #36). Clé PUBLIQUE VAPID seulement (base64url, 87 caractères) : docs/growth/rappel-quotidien.md.
# Vide : le rappel n'est ni proposé ni affiché dans le Profil. La clé PRIVÉE ne va jamais ici : secret de la fonction serveur.
VITE_VAPID_PUBLIC_KEY=

# Copie ce fichier en .env.local (ignoré par git) pour activer les comptes en local.
# Mêmes variables à définir dans Vercel (Production et Preview), en type « Config » et non « Secret » : les variables VITE_ sont intégrées au code envoyé au navigateur.
# Ces deux valeurs sont PUBLIQUES (URL du projet et clé publishable). Ne mets JAMAIS la clé service ici.
# Sans elles, l'application fonctionne hors connexion.
VITE_SUPABASE_URL=https://xjvsalkvpgcjrznznxoi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_oV20-APHu-f6cTy02Djcpw__YfgVyyo

# Réseau KataGo (facultatif). Par défaut : copie du dépôt KataGo sur raw.githubusercontent.com.
# Pour le servir avec l'app : npm run fetch-model, puis :
# VITE_KATAGO_MODEL_URL=/models/g170-b6c96-s175395328-d26788732.bin.gz

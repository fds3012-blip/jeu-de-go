{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/confidentialite", "destination": "/index.html" },
    { "source": "/j/:n(\\d{1,6})", "destination": "/j/:n/index.html" },
    { "source": "/en/j/:n(\\d{1,6})", "destination": "/en/j/:n/index.html" },
    { "source": "/defi", "destination": "/defi/index.html" },
    { "source": "/en/defi", "destination": "/en/defi/index.html" },
    { "source": "/partie", "destination": "/partie/index.html" },
    { "source": "/en/partie", "destination": "/en/partie/index.html" },
    { "source": "/apprendre-le-go", "destination": "/apprendre-le-go/index.html" },
    { "source": "/regles-du-go", "destination": "/regles-du-go/index.html" },
    { "source": "/en/learn-go", "destination": "/en/learn-go/index.html" },
    { "source": "/en/go-rules", "destination": "/en/go-rules/index.html" },
    { "source": "/en", "destination": "/en/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/reseaux/(.*)\\.bin\\.gz",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/confidentialite", "destination": "/index.html" },
    { "source": "/(apprendre|problemes|profil)", "destination": "/index.html" },
    { "source": "/(apprendre|problemes|profil)/:a", "destination": "/index.html" },
    { "source": "/(apprendre|problemes|profil)/:a/:b", "destination": "/index.html" },
    { "source": "/j/:n(\\d{1,6})", "destination": "/j/:n/index.html" },
    { "source": "/en/j/:n(\\d{1,6})", "destination": "/en/j/:n/index.html" },
    { "source": "/defi", "destination": "/defi/index.html" },
    { "source": "/en/defi", "destination": "/en/defi/index.html" },
    { "source": "/i", "destination": "/i/index.html" },
    { "source": "/en/i", "destination": "/en/i/index.html" },
    { "source": "/partie", "destination": "/partie/index.html" },
    { "source": "/en/partie", "destination": "/en/partie/index.html" },
    { "source": "/apprendre-le-go", "destination": "/apprendre-le-go/index.html" },
    { "source": "/regles-du-go", "destination": "/regles-du-go/index.html" },
    { "source": "/en/learn-go", "destination": "/en/learn-go/index.html" },
    { "source": "/en/go-rules", "destination": "/en/go-rules/index.html" },
    { "source": "/go-pour-joueurs-echecs", "destination": "/go-pour-joueurs-echecs/index.html" },
    { "source": "/en/go-for-chess-players", "destination": "/en/go-for-chess-players/index.html" },
    { "source": "/hikaru-no-go", "destination": "/hikaru-no-go/index.html" },
    { "source": "/en/hikaru-no-go", "destination": "/en/hikaru-no-go/index.html" },
    { "source": "/go-pour-enfants", "destination": "/go-pour-enfants/index.html" },
    { "source": "/en/go-for-kids", "destination": "/en/go-for-kids/index.html" },
    { "source": "/vocabulaire-du-go", "destination": "/vocabulaire-du-go/index.html" },
    { "source": "/en/go-terms", "destination": "/en/go-terms/index.html" },
    { "source": "/en", "destination": "/en/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob: https://xjvsalkvpgcjrznznxoi.supabase.co wss://xjvsalkvpgcjrznznxoi.supabase.co https://eu.i.posthog.com https://*.ingest.de.sentry.io https://*.ingest.sentry.io https://raw.githubusercontent.com https://online-go.com; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/reseaux/(.*)\\.bin\\.gz",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
